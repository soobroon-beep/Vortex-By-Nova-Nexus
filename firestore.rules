rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // Configuración, dibujos, indicadores y scripts: solo el dueño de la cuenta (mismo uid en PC, celular y cualquier dispositivo).
    match /users/{userId}/data/{docId} {
      allow read: if request.auth != null && request.auth.uid == userId;
      allow create, update: if request.auth != null
                            && request.auth.uid == userId
                            && docId in ['cct_mobile', 'scripts', 'botlab', 'claudio', 'exchanges', 'radar', 'journal', 'vigia', 'ownai', 'prefs', 'sala', 'sala_props']
                            && request.resource.size() < 1000000;   // tope de Firestore: 1 MiB por documento
      allow delete: if request.auth != null && request.auth.uid == userId;
    }

    // Nova Bot Lab: 'botlab' (tus bots) lo escribe la app; 'botlab_server' (resultados del reentrenamiento) solo lo escribe el trabajo programado con credenciales de servicio (que ignora estas reglas); tú solo puedes leerlo.
    // Claudio: 'claudio' (encendido, interruptor de emergencia, capital) lo escribe la app; 'claudio_server' (la sesión del agente) solo el trabajo programado.

    // 'sala': salas propias e historial de la app Sala de agentes. 'sala_props': bots aprobados por su Taller de bots; Nova Bot Lab los muestra para Agregar o Descartar.
    // 'prefs': el resto de tus ajustes (Nexus Pixel, cuenta demo, avisos de trades, filtros…) para que salgan igual en todos tus dispositivos.
    // 'ownai': tu propia IA (proveedor, modelo y clave): privada, solo tú la lees, para que salga igual en tu PC y tu celular.
    // 'exchanges': tu exchange conectado (API Key para el saldo, Nexus Lens y Operar). Solo tú puedes leerlo o escribirlo.

    // 'journal': copia de tu diario de trading (sin capturas). 'brain': lo que te dejan tus cerebros de Neural Brain; solo lo escribe el conector (servidor), tú solo lo lees.

    // Código de los indicadores Nova Nexus PRO: solo lo pueden leer las cuentas con el plan Infinity (lo marca el servidor en plans/{uid}).
    // Nadie lo puede escribir desde la app: lo sube el flujo «Proteger código Nova Nexus» con la cuenta de servicio.
    // Infinity vigente: el creador, el referido de BingX (refTier, hasta refEnd: se renueva cada mes con el saldo mínimo) o un pago cuya fecha (payEnd) no ha vencido (1 día de gracia).
    function proOk(p) {
      return p.get('by', '') == 'creador' || (p.get('refTier', '') == 'infinity' && (p.get('refEnd', 0) == 0 || p.get('refEnd', 0) > request.time.toMillis()))
          || (p.get('payTier', '') == 'infinity' && p.get('payEnd', 0) > request.time.toMillis() - 86400000)
          || (p.get('tier', '') == 'infinity' && !('payTier' in p) && !('refTier' in p));   // planes marcados antes de este cambio
    }
    match /pro/{id} {
      allow read: if request.auth != null
                  && exists(/databases/$(database)/documents/plans/$(request.auth.uid))
                  && proOk(get(/databases/$(database)/documents/plans/$(request.auth.uid)).data);
      allow write: if false;
    }
    // Plan verificado de cada cuenta: cada quien solo lee el suyo; solo lo escribe el servidor.
    match /plans/{userId} {
      allow read: if request.auth != null && request.auth.uid == userId;
      allow write: if false;
    }

    // Velas de VORTEX: las guarda el Motor del servidor (de Binance y, si falla, de otros exchanges). Son datos públicos de mercado:
    // cualquiera las puede leer (la app las usa si los exchanges no responden); nadie las escribe desde la app.
    match /candles/{id} {
      allow read: if true;
      allow write: if false;
    }

    // Uso de VORTEX (panel del desarrollador): cada dispositivo deja un «latido» con datos mínimos (sin correo ni nombre):
    // cuándo se vio, desde cuándo, tipo de dispositivo, si es app instalada, zona horaria e idioma. Si hay sesión, el uid (solo el propio).
    // Nadie lo puede leer salvo el creador; lo resume cada hora el trabajo programado (scripts/usage.js).
    function isCreator() {
      return request.auth != null && exists(/databases/$(database)/documents/plans/$(request.auth.uid))
          && get(/databases/$(database)/documents/plans/$(request.auth.uid)).data.get('by', '') == 'creador';
    }
    function presOk(d) {
      return d.keys().hasOnly(['at', 'first', 'uid', 'dev', 'pwa', 'tz', 'lang', 'ver', 'n', 'plan', 'src'])
          && d.at == request.time && d.uid is string && (d.uid == '' || (request.auth != null && d.uid == request.auth.uid))
          && d.dev in ['pc', 'm', 'tab'] && d.pwa is bool && d.tz is string && d.tz.size() <= 48 && d.lang is string && d.lang.size() <= 12
          && d.ver is string && d.ver.size() <= 12 && d.n is int && d.plan is string && d.plan.size() <= 12 && d.src is string && d.src.size() <= 60;
    }
    match /presence/{dev} {
      allow read: if isCreator();
      allow create: if dev.matches('^[A-Za-z0-9]{16,32}$') && presOk(request.resource.data) && request.resource.data.first == request.time && request.resource.data.n == 1;
      allow update: if presOk(request.resource.data) && request.resource.data.first == resource.data.first
                    && request.resource.data.n >= resource.data.n && request.resource.data.n <= resource.data.n + 1;
      allow delete: if false;
    }

    // Cualquier otra ruta, bloqueada.
    match /{document=**} {
      allow read, write: if false;
    }
  }
}
