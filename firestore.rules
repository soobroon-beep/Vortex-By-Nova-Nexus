rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // Configuración, dibujos, indicadores y scripts: solo el dueño de la cuenta (mismo uid en PC, celular y cualquier dispositivo).
    match /users/{userId}/data/{docId} {
      allow read: if request.auth != null && request.auth.uid == userId;
      allow create, update: if request.auth != null
                            && request.auth.uid == userId
                            && docId in ['cct_mobile', 'scripts', 'botlab', 'claudio', 'exchanges', 'radar', 'journal']
                            && request.resource.size() < 1000000;   // tope de Firestore: 1 MiB por documento
      allow delete: if request.auth != null && request.auth.uid == userId;
    }

    // Nova Bot Lab: 'botlab' (tus bots) lo escribe la app; 'botlab_server' (resultados del reentrenamiento) solo lo escribe el trabajo programado con credenciales de servicio (que ignora estas reglas); tú solo puedes leerlo.
    // Claudio: 'claudio' (encendido, interruptor de emergencia, capital) lo escribe la app; 'claudio_server' (la sesión del agente) solo el trabajo programado.

    // 'exchanges': tu exchange conectado (API Key para el saldo, Nexus Lens y Operar). Solo tú puedes leerlo o escribirlo.

    // 'journal': copia de tu diario de trading (sin capturas). 'brain': lo que te dejan tus cerebros de Neural Brain; solo lo escribe el conector (servidor), tú solo lo lees.

    // Código de los indicadores Nova Nexus PRO: solo lo pueden leer las cuentas con el plan Infinity (lo marca el servidor en plans/{uid}).
    // Nadie lo puede escribir desde la app: lo sube el flujo «Proteger código Nova Nexus» con la cuenta de servicio.
    match /pro/{id} {
      allow read: if request.auth != null
                  && get(/databases/$(database)/documents/plans/$(request.auth.uid)).data.tier == 'infinity';
      allow write: if false;
    }
    // Plan verificado de cada cuenta: cada quien solo lee el suyo; solo lo escribe el servidor.
    match /plans/{userId} {
      allow read: if request.auth != null && request.auth.uid == userId;
      allow write: if false;
    }

    // Cualquier otra ruta, bloqueada.
    match /{document=**} {
      allow read, write: if false;
    }
  }
}
